{
  "manifest_version": 3,
  "name": "AI Web Scraper",
  "version": "1.1",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Scraper Results"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}